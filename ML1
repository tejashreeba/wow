
# 1. Import libraries
import pandas as pd
import numpy as np
import seaborn as sns
import matplotlib.pyplot as plt

from sklearn.model_selection import train_test_split
from sklearn.linear_model import LinearRegression
from sklearn.ensemble import RandomForestRegressor
from sklearn.metrics import r2_score, mean_absolute_error, mean_squared_error
from math import *


# 2. Load dataset
df = pd.read_csv("uber.csv")


# 3. Remove missing values
df = df.dropna()


# 4. Check missing values
print(df.isnull().sum())


# 5. Remove unnecessary columns
df = df.drop("Unnamed: 0", axis=1)
df = df.drop("key", axis=1)


# 6. Convert pickup_datetime into datetime format
df["pickup_datetime"] = pd.to_datetime(
    df["pickup_datetime"], errors="coerce"
)


# 7. Extract hour and day
df["hour"] = df["pickup_datetime"].dt.hour
df["mainday"] = df["pickup_datetime"].dt.day


# 8. Remove original datetime column
df = df.drop("pickup_datetime", axis=1)


# 9. Remove invalid fare and passenger records
df = df[df["fare_amount"] > 0]
df = df[df["passenger_count"] > 0]


# 10. Visualize outliers using boxplot
sns.boxplot(x=df["fare_amount"])
plt.show()


# 11. Calculate IQR
q1 = df["fare_amount"].quantile(0.25)
q3 = df["fare_amount"].quantile(0.75)

IQR = q3 - q1

lower = q1 - 1.5 * IQR
upper = q3 + 1.5 * IQR


# 12. Remove outliers
df = df[
    (df["fare_amount"] >= lower) &
    (df["fare_amount"] <= upper)
]

# Alternative method using clipping
# df["fare_amount"] = df["fare_amount"].clip(lower, upper)


# 13. Draw correlation heatmap
plt.figure(figsize=(10, 6))

sns.heatmap(
    df.corr(numeric_only=True),
    annot=True,
    cmap="coolwarm"
)

plt.show()


# 14. Check correlation with fare amount
corr = df.corr(numeric_only=True)
print(corr["fare_amount"])


# 15. Convert latitude and longitude into radians
lat1 = np.radians(df["pickup_latitude"])
lat2 = np.radians(df["dropoff_latitude"])

lon1 = np.radians(df["pickup_longitude"])
lon2 = np.radians(df["dropoff_longitude"])


# 16. Calculate distance using Haversine formula
dlat = lat2 - lat1
dlon = lon2 - lon1

a = (
    sin(dlat / 2) ** 2
    + cos(lat1) * cos(lat2)
    * sin(dlon / 2) ** 2
)

c = 2 * asin(sqrt(a))

df["distance_km"] = 6371 * c


# 17. Separate input and output
X = df.drop("fare_amount", axis=1)
y = df["fare_amount"]


# 18. Split dataset into training and testing data
X_train, X_test, y_train, y_test = train_test_split(
    X, y, random_state=42, test_size=0.2
)


# 19. Linear Regression model
lr = LinearRegression()

lr.fit(X_train, y_train)

lr_pred = lr.predict(X_test)

print(lr_pred)

print(lr.intercept_)


# 20. Random Forest Regression model
rf = RandomForestRegressor(
    n_estimators=10,
    random_state=42
)

rf.fit(X_train, y_train)

rf_pred = rf.predict(X_test)

print(rf_pred)


# 21. Compare both models
results = pd.DataFrame({
    "Model": ["LR", "RF"],

    "R2": [
        r2_score(y_test, lr_pred),
        r2_score(y_test, rf_pred)
    ],

    "MAE": [
        mean_absolute_error(y_test, lr_pred),
        mean_absolute_error(y_test, rf_pred)
    ],

    "RMSE": [
        sqrt(mean_squared_error(y_test, lr_pred)),
        sqrt(mean_squared_error(y_test, rf_pred))
    ]
})

print("\nModel Comparison:")
print(results)
